{%- comment -%}
  Sunflour Schema Snippet
  Outputs: Organization, Store, WebSite, Product (on product pages), Article (on article pages)
  Title/meta/robots are handled by theme.liquid natively — not by this snippet.
{%- endcomment -%}

{%- assign _str_type  = 'Store' -%}
{%- assign _str_price = '0 - 95' -%}
{%- assign _schema_img = 'https://cdn.shopify.com/s/files/1/0079/6121/5087/files/Logo_725908c7-bc96-4eac-acfd-a64eed932c35.png' -%}

{%- comment -%} Organization {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "Organization",
  "url": "{{ shop.url }}",
  "logo": "{{ _schema_img }}"
  {%- assign _sa = '' -%}
  {%- if settings.social_instagram_link != blank -%}{%- unless _sa == '' -%}{%- assign _sa = _sa | append: ',' -%}{%- endunless -%}{%- assign _sa = _sa | append: '"' | append: settings.social_instagram_link | append: '"' -%}{%- endif -%}
  {%- if settings.social_facebook_link != blank -%}{%- unless _sa == '' -%}{%- assign _sa = _sa | append: ',' -%}{%- endunless -%}{%- assign _sa = _sa | append: '"' | append: settings.social_facebook_link | append: '"' -%}{%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}{%- unless _sa == '' -%}{%- assign _sa = _sa | append: ',' -%}{%- endunless -%}{%- assign _sa = _sa | append: '"' | append: settings.social_pinterest_link | append: '"' -%}{%- endif -%}
  {%- if settings.social_twitter_link != blank -%}{%- unless _sa == '' -%}{%- assign _sa = _sa | append: ',' -%}{%- endunless -%}{%- assign _sa = _sa | append: '"' | append: settings.social_twitter_link | append: '"' -%}{%- endif -%}
  {%- unless _sa == '' -%},"sameAs": [{{ _sa }}]{%- endunless -%}
}
</script>

{%- comment -%} Store / LocalBusiness {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "http://www.schema.org",
  "@type": "{{ _str_type }}",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "logo": "{{ _schema_img }}",
  "image": "{{ _schema_img }}"
  {%- unless shop.description == '' -%},"description": {{ shop.description | json }}{%- endunless -%}
  ,"priceRange": "{{ _str_price }}"
  {%- if shop.phone != blank -%},"telephone": {{ shop.phone | json }}{%- endif -%}
  {%- unless shop.address.country == '' -%}
  ,"address": {
    "@type": "PostalAddress"
    {%- if shop.address.street != blank -%},"streetAddress": {{ shop.address.street | json }}{%- endif -%}
    {%- if shop.address.city != blank -%},"addressLocality": {{ shop.address.city | json }}{%- endif -%}
    {%- if shop.address.province_code != blank -%},"addressRegion": {{ shop.address.province_code | json }}{%- endif -%}
    {%- if shop.address.zip != blank -%},"postalCode": {{ shop.address.zip | json }}{%- endif -%}
    {%- if shop.address.country_code != blank -%},"addressCountry": {{ shop.address.country_code | json }}{%- endif -%}
  }
  {%- endunless -%}
  {%- unless shop.latitude == blank or shop.longitude == blank -%}
  ,"geo": {
    "@type": "GeoCoordinates",
    "latitude": "{{ shop.latitude }}",
    "longitude": "{{ shop.longitude }}"
  }
  {%- endunless -%}
}
</script>

{%- comment -%} WebSite {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "WebSite",
  "url": "{{ shop.url }}/",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- comment -%} Product schema {%- endcomment -%}
{%- if request.page_type == 'product' -%}
<script>
var spProductSchemaJson = {
  "@context": "http://schema.org",
  "@type": "Product",
  "brand": {
    "@type": "Brand",
    "name": {{ product.vendor | json }}
  },
  "@id": {{ canonical_url | json }},
  "sku": {{ product.selected_or_first_available_variant.sku | json }},
  "description": {{ page_description | default: product.description | strip_html | json }},
  "url": {{ canonical_url | json }},
  "name": {{ product.title | json }},
  {%- if product.featured_image -%}
  "image": "https:{{ product.featured_image | product_img_url: 'grande' }}",
  {%- endif -%}
  "offers": {
    "@type": "Offer",
    "url": {{ canonical_url | json }},
    "sku": {{ product.selected_or_first_available_variant.sku | json }},
    "price": "{{ product.selected_or_first_available_variant.price | money_without_currency | replace: ',', '' }}",
    "priceCurrency": "{{ shop.currency }}",
    "availability": "{%- if product.selected_or_first_available_variant.available -%}InStock{%- else -%}OutOfStock{%- endif -%}"
  }
  {%- if product.metafields.yotpo.reviews_count and product.metafields.yotpo.reviews_count != "0" -%}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ product.metafields.yotpo.reviews_average }},
    "ratingCount": {{ product.metafields.yotpo.reviews_count }}
  }
  {%- endif -%}
  ,"shippingDetails": {
    "@type": "OfferShippingDetails",
    "shippingDestination": {
      "@type": "DefinedRegion",
      "addressCountry": "US"
    },
    "deliveryTime": {
      "@type": "ShippingDeliveryTime",
      "handlingTime": {
        "@type": "QuantitativeValue",
        "minValue": 0,
        "maxValue": 1,
        "unitCode": "DAY"
      },
      "transitTime": {
        "@type": "QuantitativeValue",
        "minValue": 2,
        "maxValue": 5,
        "unitCode": "DAY"
      }
    }
  }
  ,"hasMerchantReturnPolicy": {
    "@type": "MerchantReturnPolicy",
    "applicableCountry": "US",
    "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted",
    "merchantReturnLink": "https://sunflourbakingcompany.com/pages/return-policy"
  }
};

var el = document.createElement('script');
el.type = 'application/ld+json';
el.text = JSON.stringify(spProductSchemaJson);
setTimeout(function(){ document.body.appendChild(el); }, 200);
</script>
{%- endif -%}

{%- comment -%} Article + Breadcrumb schema {%- endcomment -%}
{%- if request.page_type == 'article' -%}
  {%- liquid
    assign article_word_count = article.content | strip_html | split: ' ' | size
    assign article_minutes = article_word_count | divided_by: 220 | at_least: 1
    assign article_author_name = 'Sunflour Team'
    assign article_author_url = shop.url | append: '/pages/about-us'
  -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {{ canonical_url | json }},
  "headline": {{ article.title | json }},
  "image": {
    "@type": "ImageObject",
    {%- if article.image -%}
      "url": "https:{{ article.image | image_url: width: 1600 }}",
      "width": "{{ article.image.width }}",
      "height": "{{ article.image.height }}"
    {%- else -%}
      "url": "{{ _schema_img }}",
      "width": "1024",
      "height": "1024"
    {%- endif -%}
  },
  "author": {
    "@type": "Organization",
    "name": {{ article_author_name | json }},
    "url": {{ article_author_url | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "logo": {
      "@type": "ImageObject",
      "url": "{{ _schema_img }}"
    }
  },
  "datePublished": "{{ article.created_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
  "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }},
  "inLanguage": "en-US",
  "articleSection": {{ blog.title | json }},
  "wordCount": {{ article_word_count }},
  "timeRequired": "PT{{ article_minutes }}M"
  {%- if article.tags.size > 0 -%}
  ,"keywords": {{ article.tags | join: ', ' | json }}
  {%- endif -%}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | json }},
      "item": "{{ shop.url }}{{ blog.url }}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ article.title | json }},
      "item": "{{ shop.url }}{{ article.url }}"
    }
  ]
}
</script>
{%- endif -%}
