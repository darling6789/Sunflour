{% comment %}
  Auto-generated table of contents.
  Scans the rendered .article-template__content for h2 and h3 elements,
  assigns slugified IDs, and builds a nav. Hides itself if fewer than 3 H2s found.

  Usage: {% render 'article-toc' %}
{% endcomment %}

<nav class="article-toc" aria-label="On this page" data-article-toc hidden>
  <h2 class="article-toc__heading">On this page</h2>
  <ol class="article-toc__list" data-article-toc-list></ol>
</nav>

<script>
  (function () {
    document.addEventListener('DOMContentLoaded', function () {
      var nav = document.querySelector('[data-article-toc]');
      var list = document.querySelector('[data-article-toc-list]');
      var content = document.querySelector('.article-template__content');
      if (!nav || !list || !content) return;

      var headings = content.querySelectorAll('h2, h3');
      if (headings.length < 3) return;

      var h2Count = 0;
      content.querySelectorAll('h2').forEach(function () { h2Count++; });
      if (h2Count < 3) return;

      var slugify = function (text) {
        return text
          .toLowerCase()
          .trim()
          .replace(/[^\w\s-]/g, '')
          .replace(/[\s_-]+/g, '-')
          .replace(/^-+|-+$/g, '');
      };

      var usedIds = {};
      headings.forEach(function (heading) {
        var text = heading.textContent.trim();
        if (!text) return;
        var baseId = slugify(text) || 'section';
        var id = baseId;
        var i = 1;
        while (usedIds[id] || document.getElementById(id)) {
          i++;
          id = baseId + '-' + i;
        }
        usedIds[id] = true;
        if (!heading.id) heading.id = id;

        var li = document.createElement('li');
        li.className = 'article-toc__item article-toc__item--' + heading.tagName.toLowerCase();
        var a = document.createElement('a');
        a.className = 'article-toc__link';
        a.href = '#' + heading.id;
        a.textContent = text;
        li.appendChild(a);
        list.appendChild(li);
      });

      if (list.children.length > 0) {
        nav.hidden = false;
      }
    });
  })();
</script>
