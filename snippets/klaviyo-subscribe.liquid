{%- comment -%}
  Routes ALL newsletter signups (forms with class "newsletter-form") into Klaviyo
  instead of Shopify's customer form.

  - Catches every newsletter form sitewide (location pages, footer, newsletter
    section, email-signup banner, custom-subscribe) with one delegated listener.
  - Subscribes the email to the Newsletter list, which triggers the welcome flow.
    The Newsletter list uses double opt-in, so subscribers receive a confirmation
    email before they are fully subscribed.
  - Progressive enhancement: if this script fails to load, forms fall back to
    their native Shopify customer-form submission.

  Uses Klaviyo's CORS-enabled list-subscribe endpoint (manage.kmail-lists.com) —
  the same mechanism Klaviyo's own hosted signup forms use. The JSON:API
  /client/subscriptions endpoint is NOT usable here: it has no CORS headers for
  browser calls from a custom origin.

  Klaviyo Newsletter list id: V9FgNi
  Contact/inquiry forms (form 'contact') are NOT affected (no newsletter-form class).
{%- endcomment -%}
<script>
  (function () {
    var LIST_ID = 'V9FgNi'; // Newsletter
    var ENDPOINT = 'https://manage.kmail-lists.com/ajax/subscriptions/subscribe';

    function isValidEmail(v) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
    }

    function setMessage(form, text, isError) {
      var el = form.querySelector('.klaviyo-subscribe__message');
      if (!el) {
        el = document.createElement('p');
        el.className = 'klaviyo-subscribe__message newsletter-form__message form__message';
        el.setAttribute('tabindex', '-1');
        form.appendChild(el);
      }
      el.classList.toggle('newsletter-form__message--success', !isError);
      el.textContent = text;
      try { el.focus(); } catch (e) {}
    }

    function onSubmit(e) {
      var form = e.target;
      if (!form || typeof form.matches !== 'function' || !form.matches('form.newsletter-form')) return;

      var emailInput = form.querySelector('input[type="email"], input[name="contact[email]"]');
      if (!emailInput) return; // no email field -> let it submit natively

      e.preventDefault();

      var email = (emailInput.value || '').trim();
      if (!isValidEmail(email)) {
        setMessage(form, 'Please enter a valid email address.', true);
        try { emailInput.focus(); } catch (err) {}
        return;
      }

      var button = form.querySelector('[type="submit"]');
      if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); }

      function reEnable() {
        if (button) { button.disabled = false; button.removeAttribute('aria-busy'); }
      }

      var source = 'Website signup';
      try { source = (document.title || 'Website') + ' (' + window.location.pathname + ')'; } catch (err) {}

      var params = new URLSearchParams();
      params.set('g', LIST_ID);
      params.set('email', email);
      params.set('$fields', '$source');
      params.set('$source', source);

      fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString()
      }).then(function (res) {
        return res.json().catch(function () { return null; });
      }).then(function (body) {
        if (body && body.success) {
          var fieldWrap = form.querySelector('.field, .newsletter-form__field-wrapper');
          if (fieldWrap) { fieldWrap.style.display = 'none'; }
          setMessage(form, 'Thanks for subscribing! Check your inbox to confirm — your welcome offer is on the way.', false);
        } else {
          reEnable();
          var msg = 'Sorry, something went wrong. Please try again.';
          if (body && body.errors && body.errors.length) { msg = body.errors[0]; }
          setMessage(form, msg, true);
        }
      }).catch(function () {
        reEnable();
        setMessage(form, 'Sorry, something went wrong. Please try again.', true);
      });
    }

    document.addEventListener('submit', onSubmit, true);
  })();
</script>
