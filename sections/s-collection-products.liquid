{% assign collection = section.settings.collection %}

<div class="s-all-products p-width">
  <div class="s-all-products-header">
    <h1>{{ section.settings.heading }}</h1>  
    {% comment %} <div class="s-all-products-btns">
      <a href="#" class="s-btn">local pickup</a>
      <a href="#" class="s-btn">nationwide delivery</a>
    </div> {% endcomment %}
  </div>
  
  <div class="s-all-products-wrap">
    {% for product in collection.products limit: section.settings.limit %}
      {% render 's-product-card', product: product %}
    {% endfor %}
  </div>

  {%- if section.settings.button_label != blank -%}
    <div class="s-all-products-bottom-btn" style="text-align: center; margin-top: 40px;">
      <a href="{{ section.settings.button_link }}" class="s-btn" style="background-color: #873c17; color: #fff; padding: 12px 32px; border-radius: 40px; text-decoration: none; font-weight: 600; display: inline-block;">
        {{ section.settings.button_label }}
      </a>
    </div>
  {%- endif -%}
</div>

<style>
.s-collection-products-section {
  width: 100%;
  padding-bottom: 60px;
  padding-left: 40px;
  padding-right: 40px;
}
.s-all-products-header {
  width: 100%;
}
.s-all-products-header h1 {
  text-align: center;
  margin-bottom: 60px;
}
.s-all-products-wrap {
  margin-top: 40px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px 24px;
}

/* ─── Product card ────────────────────────────────────────────────────────── */
.s-all-products-wrap .s-product-card {
  display: flex;
  flex-direction: column;
  width: 100%;
}
.s-all-products-wrap .s-product-card-image {
  display: block;
  width: 100%;
  aspect-ratio: 1;
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  line-height: 0;
}
.s-all-products-wrap .s-product-card-image-1,
.s-all-products-wrap .s-product-card-image-2 {
  display: block;
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  top: 0;
  left: 0;
  transition: opacity 0.3s ease;
}
.s-all-products-wrap .s-product-card-image-2 {
  opacity: 0;
}
.s-all-products-wrap .s-product-card:hover .s-product-card-image-1 {
  opacity: 0;
}
.s-all-products-wrap .s-product-card:hover .s-product-card-image-2 {
  opacity: 1;
}

/* ─── Card info (below image) ────────────────────────────────────────────── */
.s-all-products-wrap .s-product-card-info {
  padding: 14px 4px 0;
}
.s-all-products-wrap .s-product-card-des {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
  text-decoration: none;
  color: inherit;
  margin-bottom: 12px;
}
.s-all-products-wrap .s-product-card-des:hover h4 {
  text-decoration: underline;
}
.s-all-products-wrap .s-product-card-des h4 {
  margin: 0;
  font-weight: 600;
  font-size: 15px;
  line-height: 1.3;
}
.s-all-products-wrap .s-product-price {
  line-height: 1;
  white-space: nowrap;
  font-size: 15px;
}

/* ─── Actions row ─────────────────────────────────────────────────────────── */
.s-all-products-wrap .s-product-card-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.s-all-products-wrap .s-add-to-cart-form {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
}
.s-all-products-wrap .s-add-to-cart-btn.s-btn {
  background-color: #873c17;
  color: #fff;
  text-decoration: none;
  height: 38px;
  padding: 0 20px;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40px;
  cursor: pointer;
  font-weight: 600 !important;
  border: none;
  font-size: 13px;
  flex: 1;
  white-space: nowrap;
}
.s-all-products-wrap .s-add-to-cart-btn.s-btn:hover {
  background-color: #6e2f12;
}
.s-all-products-wrap .s-quantity-row {
  display: flex;
  align-items: center;
  border: 1.5px solid #ccc;
  border-radius: 40px;
  overflow: hidden;
  flex-shrink: 0;
}
.s-all-products-wrap .s-qty-btn {
  background: transparent;
  border: none;
  color: #333;
  width: 30px;
  height: 32px;
  font-size: 16px;
  line-height: 1;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  font-weight: 600;
  flex-shrink: 0;
}
.s-all-products-wrap .s-qty-btn:hover {
  background: #f5f0e8;
}
.s-all-products-wrap .s-qty-input {
  width: 30px;
  text-align: center;
  border: none;
  border-left: 1px solid #ccc;
  border-right: 1px solid #ccc;
  font-size: 13px;
  height: 32px;
  padding: 0;
  -moz-appearance: textfield;
  outline: none;
  background: transparent;
}
.s-all-products-wrap .s-qty-input::-webkit-inner-spin-button,
.s-all-products-wrap .s-qty-input::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

@media (max-width: 990px) {
  .s-collection-products-section {
    padding-left: 20px;
    padding-right: 20px;
  }
  .s-all-products-header h1 {
    margin-bottom: 40px;
  }
  .s-all-products-wrap {
    grid-template-columns: repeat(3, 1fr);
    gap: 28px 20px;
  }
}

@media (max-width: 600px) {
  .s-collection-products-section {
    padding-bottom: 40px;
  }
  .s-all-products-wrap {
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 16px;
  }
  .s-all-products-wrap .s-add-to-cart-form {
    flex-wrap: wrap;
  }
  .s-all-products-wrap .s-quantity-row {
    width: 100%;
    justify-content: center;
  }
  .s-all-products-wrap .s-add-to-cart-btn.s-btn {
    width: 100%;
  }
}
</style>

{% schema %}
{
  "name": "S collection products",
  "tag": "section",
  "class": "s-collection-products-section",
  "settings": [
    {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ship Sunflour Goods Nationwide"
    },
    {
      "type": "number",
      "id": "limit",
      "label": "Max products to show",
      "default": 16
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Browse Our Online Shop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "S collection products"
    }
  ]
}
{% endschema %}