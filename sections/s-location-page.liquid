{%- comment -%}
  Location Page Section — redesigned 2026-04-06
  Sections: 1) Hero  2) Essentials Card  3) Social Proof  4) FAQ + Newsletter placeholder
  All location-specific content pulls from page.metafields.global.* namespace.
  Per-location content (H1, parking, FAQs) keyed by page.handle.
{%- endcomment -%}

{%- liquid
  assign loc_handle = page.handle

  if loc_handle == 'charlotte-bakery-elizabeth'
    assign loc_h1         = 'Welcome to Your Elizabeth Community Bakery'
    assign loc_neighborhood = 'Elizabeth'
    assign loc_parking    = 'Dedicated parking lot accessible off 7th Street. Short walk from Independence Park and local bus stops.'
    assign loc_street     = '7th Street'
    assign loc_slug       = 'elizabeth'
  elsif loc_handle == 'charlotte-bakery-dilworth'
    assign loc_h1         = 'Welcome to Your Dilworth Community Bakery'
    assign loc_neighborhood = 'Dilworth'
    assign loc_parking    = 'Street parking on East Boulevard and nearby side streets. Easily walkable from the Dilworth neighborhood.'
    assign loc_street     = 'East Boulevard'
    assign loc_slug       = 'dilworth'
  elsif loc_handle == 'ballantyne-bakery'
    assign loc_h1         = 'Welcome to Our Ballantyne Bakery'
    assign loc_neighborhood = 'Ballantyne'
    assign loc_parking    = 'Ample parking in the Conlan Circle shopping center lot directly adjacent to the bakery.'
    assign loc_street     = 'Conlan Circle'
    assign loc_slug       = 'ballantyne'
  elsif loc_handle == 'harrisburg-nc-bakery'
    assign loc_h1         = 'Welcome to Our Harrisburg Community Bakery'
    assign loc_neighborhood = 'Harrisburg'
    assign loc_parking    = 'Large parking lot directly in front of the bakery. Easy access right off NC-49.'
    assign loc_street     = 'NC-49'
    assign loc_slug       = 'harrisburg'
  elsif loc_handle == 'charlotte-bakery-noda'
    assign loc_h1         = 'Welcome to Your NoDa Community Bakery'
    assign loc_neighborhood = 'NoDa'
    assign loc_parking    = 'Street parking available on Jordan Place. Close to the NoDa light rail station.'
    assign loc_street     = 'Jordan Place'
    assign loc_slug       = 'noda'
  else
    assign loc_h1         = page.title
    assign loc_neighborhood = 'Charlotte'
    assign loc_parking    = ''
    assign loc_street     = ''
    assign loc_slug       = ''
  endif
-%}

<div class="loc-hero" style="background-image: url({{ page.metafields.global.image }});">
  <div class="loc-hero__overlay">
    <div class="loc-hero__content">
      <h1 class="loc-hero__h1">{{ loc_h1 }}</h1>
      <h2 class="loc-hero__h2">{{ page.metafields.global.title }}</h2>
      <p class="loc-hero__tagline">Fresh, Artisanal Quality, and Community, Baked Daily.</p>
    </div>
  </div>
</div>

<div class="loc-essentials">
  <div class="loc-essentials__card">
    <div class="loc-essentials__map">
      <iframe
        loading="lazy"
        src="{{ page.metafields.global.google_map_iframe_src }}"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen=""
        title="Map of Sunflour Baking Company {{ loc_neighborhood }}"
      ></iframe>
    </div>

    <div class="loc-essentials__info">
      {%- if page.metafields.global.address != blank -%}
        <div class="loc-info-row">
          <span class="loc-info-row__icon"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span>
          <span class="loc-info-row__text">
            <a href="{{ page.metafields.global.get_direction_button_link }}" target="_blank" rel="noopener">{{ page.metafields.global.address }}</a>
          </span>
        </div>
      {%- endif -%}

      {%- if page.metafields.global.phone != blank and page.metafields.global.phone != '-' -%}
        <div class="loc-info-row">
          <span class="loc-info-row__icon"><i class="fas fa-phone" aria-hidden="true"></i></span>
          <span class="loc-info-row__text">
            <a href="tel:{{ page.metafields.global.phone | remove: '-' | remove: ' ' | prepend: '+1' }}">{{ page.metafields.global.phone }}</a>
          </span>
        </div>
      {%- endif -%}

      {%- if page.metafields.global.email != blank -%}
        <div class="loc-info-row">
          <span class="loc-info-row__icon"><i class="fas fa-envelope" aria-hidden="true"></i></span>
          <span class="loc-info-row__text">
            <a href="mailto:{{ page.metafields.global.email }}">{{ page.metafields.global.email }}</a>
          </span>
        </div>
      {%- endif -%}

      <div class="loc-info-row">
        <span class="loc-info-row__icon"><i class="fas fa-clock" aria-hidden="true"></i></span>
        <span class="loc-info-row__text">Mon &ndash; Sun: 7:00 AM &ndash; 4:00 PM</span>
      </div>

      {%- if loc_parking != blank -%}
        <div class="loc-info-row">
          <span class="loc-info-row__icon"><i class="fas fa-car" aria-hidden="true"></i></span>
          <span class="loc-info-row__text">{{ loc_parking }}</span>
        </div>
      {%- endif -%}

      <div class="loc-btn-cluster">
        <a class="loc-btn" href="{{ page.metafields.global.get_direction_button_link }}" target="_blank" rel="noopener">
          <i class="fas fa-directions" aria-hidden="true"></i> Get Directions (Google Maps)
        </a>
        {%- if page.metafields.global.order_button_link != blank -%}
          <a class="loc-btn" href="{{ page.metafields.global.order_button_link }}" target="_blank" rel="noopener">
            <i class="fas fa-shopping-bag" aria-hidden="true"></i> Order Online for Pickup
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<div class="loc-social-proof">
  <div class="loc-social-proof__inner">
    <div class="loc-stars" aria-label="5 out of 5 stars">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#e8a020" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#e8a020" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#e8a020" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#e8a020" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#e8a020" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
    </div>
    <blockquote class="loc-social-proof__quote">
      "The coffee in an ice cream cone is unique, and the pastries are incredibly delicious, especially the flakey croissants. The loyalty program is a great local perk, making you feel right at home with free coffee points."
    </blockquote>
    <p class="loc-social-proof__attribution">— Google Review</p>
    <a class="loc-social-proof__cta" href="{{ page.metafields.global.get_direction_button_link }}" target="_blank" rel="noopener">
      Leave us a review on Google
    </a>
  </div>
</div>

<div class="loc-bottom-grid">

    <div class="loc-faq">
    <h2 class="loc-faq__title">Frequently Asked Questions</h2>

      {%- case loc_slug -%}

      {%- when 'elizabeth' -%}
        <button class="accordion">When do you bake fresh daily at the 7th Street location?</button>
        <div class="panel"><p>Everything is baked fresh every morning right here, ready and waiting when we open at 7am. Come early for the best selection.</p></div>

        <button class="accordion">Is there parking at your Elizabeth bakery?</button>
        <div class="panel"><p>{{ loc_parking }}</p></div>

        <button class="accordion">Is there seating for working or groups at the Elizabeth location?</button>
        <div class="panel"><p>Yes. The Elizabeth cafe is a great spot to hang out, get work done, or catch up with friends. We have free WiFi and plenty of room to settle in.</p></div>

        <button class="accordion">What are the best gluten-free options at the Elizabeth location?</button>
        <div class="panel"><p>We regularly stock GF cheesecakes, chocolate soufflé cakes, and coconut macaroons at this location. Note: while these items are made without gluten, our bakeries are not dedicated GF facilities, so trace levels of gluten are possible.</p></div>

        <button class="accordion">How do I place a custom cake order for the Elizabeth location?</button>
        <div class="panel"><p>Email <a href="mailto:{{ page.metafields.global.email }}">{{ page.metafields.global.email }}</a> or call <a href="tel:+17049005268">{{ page.metafields.global.phone }}</a>. We require at least 48 hours notice for standard orders, and 1 to 2 months for elaborate cakes.</p></div>

