        <button class="accordion">Can I order a custom cake from the Ballantyne location?</button>
        <div class="panel"><p>Yes. Email <a href="mailto:{{ page.metafields.global.email }}">{{ page.metafields.global.email }}</a> or call <a href="tel:+19802378881">{{ page.metafields.global.phone }}</a>. We require at least 48 hours notice for standard orders, and 1 to 2 months for elaborate cakes.</p></div>

      {%- when 'harrisburg' -%}
        <button class="accordion">When do you bake fresh daily on NC-49?</button>
        <div class="panel"><p>Everything is baked fresh every morning right here, ready and waiting when we open at 7am. Come early for the best selection.</p></div>

        <button class="accordion">Is there parking at your Harrisburg bakery?</button>
        <div class="panel"><p>{{ loc_parking }}</p></div>

