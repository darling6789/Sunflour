          </div>
          <div class="loc-review-card">
            <div class="loc-stars" aria-label="5 out of 5 stars">{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}</div>
            <blockquote class="loc-review-card__quote">"Morning crew is always personable. Everyone makes you feel welcome and appreciated. Food and drink quality is always excellent."</blockquote>
            <p class="loc-review-card__attribution">— Jay Poff, Google Review</p>
          </div>

        {%- when 'dilworth' -%}
          <div class="loc-review-card">
            <div class="loc-stars" aria-label="5 out of 5 stars">{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}</div>
